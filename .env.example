# Get a key at https://aistudio.google.com/apikey and put it in .env (not this file).
GEMINI_API_KEY=
# (If GEMINI_API_KEY is unset, VOICE_DEV_GEMINI_KEY is used instead.)

# Optional settings
# live (default): stream while held, text about 1 s after release.
# oneshot: send the clip after release (also the automatic fallback).
# FLOWCODE_MODE=live
# GEMINI_MODEL=gemini-3.8-flash
# FLOWCODE_LIVE_MODEL=gemini-3.8-live
# FLOWCODE_CLEANUP_MODEL=gemini-3.5-flash-lite
# Silence cutoff in dBFS; quieter clips are not sent.
# FLOWCODE_SILENCE_DB=-40
# Hotkey to hold while talking. CTRL/SUPER/ALT/SHIFT match either side;
# exact evdev names (KEY_RIGHTCTRL, KEY_F13, ...) also work.
# FLOWCODE_HOTKEY=CTRL+SUPER
# FLOWCODE_DEBUG=1      # log every hotkey key event with its device
# FLOWCODE_DRY_RUN=1    # do everything except paste
# Path to a dictionary file (one word or phrase per line).
# FLOWCODE_DICTIONARY=dictionary.txt
# Set to 0 to leave the dictated text on the clipboard instead of restoring.
# FLOWCODE_RESTORE_CLIPBOARD=1
